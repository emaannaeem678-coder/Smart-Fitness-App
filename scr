    void BMI() {
        JFrame frame = new JFrame("BMI Calculator");
        frame.setSize(400, 300);
        frame.getContentPane().setBackground(new Color(242, 200, 243));
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(null);
        JLabel weightLabel = new JLabel("Weight (kg):");
        weightLabel.setBounds(20, 20, 100, 30);
        JTextField weightField = new JTextField();
        weightField.setBounds(120, 20, 150, 30);
        JLabel heightLabel = new JLabel("Height (cm):");
        heightLabel.setBounds(20, 60, 100, 30);
        JTextField heightField = new JTextField();
        heightField.setBounds(120, 60, 150, 30);
        JButton calculateButton = new JButton("Calculate");
        calculateButton.setBounds(80, 100, 120, 30);
        calculateButton.setBackground(new Color(100, 149, 237));
        JLabel resultLabel = new JLabel("Result:");
        resultLabel.setBounds(20, 140, 250, 30);
        JButton mainmenu=new JButton("Main Menu");
        mainmenu.setBounds(150,170,120,30);
        mainmenu.setBackground(new Color(100, 149, 237));

        calculateButton.addActionListener(e -> {
            try {
                double weight = Double.parseDouble(weightField.getText());
                double heightCm = Double.parseDouble(heightField.getText());
                double height = heightCm / 100; // convert cm to meters
                double bmi = weight / (height * height);
                String status;
                if (bmi < 18.5) {
                    status = "Underweight";
                } else if (bmi < 24.9) {
                    status = "Normal weight";
                } else if (bmi < 29.9) {
                    status = "Overweight";
                } else {
                    status = "Obese";
                }
                resultLabel.setText(String.format("BMI: %.2f - %s", bmi, status));
            } catch (NumberFormatException ex) {
                resultLabel.setText("Please enter valid numbers!");
            }
        });

        mainmenu.addActionListener(e -> {
            frame.dispose();
            showmainmenu();
        });

        frame.add(weightLabel);
        frame.add(weightField);
        frame.add(heightLabel);
        frame.add(heightField);
        frame.add(calculateButton);
        frame.add(resultLabel);
        frame.add(mainmenu);
        frame.setLocationRelativeTo(null); // Center on screen
        frame.setVisible(true);
    }

    void caloriescalc() {
        JFrame frame = new JFrame("Calories Calculator");
        frame.setSize(400, 400);
