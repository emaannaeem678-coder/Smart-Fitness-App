        weightLabel.setBounds(20, 70, 100, 30);
        JTextField weightField = new JTextField();
        weightField.setBounds(150, 70, 150, 30);
        JLabel durationLabel = new JLabel("Duration (min):");
        durationLabel.setBounds(20, 110, 120, 30);
        JTextField durationField = new JTextField();
        durationField.setBounds(150, 110, 150, 30);

        JLabel workoutTypeLabel = new JLabel("Workout Type:");
        workoutTypeLabel.setBounds(20, 150, 120, 30);
        JComboBox<String> activityDropdown = new JComboBox<>(new String[]{"Walking", "Running", "Cycling", "Yoga", "Weight Training"});
        activityDropdown.setBounds(150, 150, 150, 30);
        JButton calculateButton = new JButton("Calculate");
        calculateButton.setBounds(100, 200, 120, 30);
        calculateButton.setBackground(new Color(100, 149, 237));
        JLabel resultLabel = new JLabel("Result:");
        resultLabel.setBounds(20, 240, 300, 30);
        JButton mainmenu=new JButton("Main Menu");
        mainmenu.setBounds(250,270,120,30);
        mainmenu.setBackground(new Color(100, 149, 237));
        mainmenu.addActionListener(e -> {
            frame.dispose();
            showmainmenu();
        });
        calculateButton.addActionListener(e -> {
            try {
                double weight = Double.parseDouble(weightField.getText().trim());
                double duration = Double.parseDouble(durationField.getText().trim());
                String activity = activityDropdown.getSelectedItem().toString().trim();
                double met = 0;
                switch (activity) {
                    case "Walking":
                        met = 3.5;
                        break;
                    case "Running":
                        met = 7.0;
                        break;
                    case "Cycling":
                        met = 6.0;
                        break;
                    case "Yoga":
                        met = 2.5;
                        break;
                    case "Weight Training":
                        met = 5.0;
                        break;
                }
                double calories = (met * weight * duration) / 60;
                resultLabel.setText(String.format("Calories Burned: %.2f", calories));
            } catch (NumberFormatException ex) {
                resultLabel.setText("Please enter valid numbers!");
            }
        });
        frame.add(weightLabel);
        frame.add(weightField);
        frame.add(durationLabel);
        frame.add(durationField);
        frame.add(workoutTypeLabel);
        frame.add(activityDropdown);
        frame.add(calculateButton);
        frame.add(resultLabel);
        frame.add(mainmenu);
        frame.setLocationRelativeTo(null); // Center on screen
        frame.setVisible(true);
    }

